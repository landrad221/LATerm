        0x1DC0 0x1DFF
        0x20D0 0x20FF
        0xFE00 0xFE0F
        0xFE20 0xFE2F
        0xE0100 0xE01EF
    }

    variable wideRanges {
        0x1100 0x115F
        0x231A 0x231B
        0x2329 0x232A
        0x23E9 0x23EC
        0x23F0 0x23F0
        0x23F3 0x23F3
        0x25FD 0x25FE
        0x2614 0x2615
