        0x26D4 0x26D4
        0x26EA 0x26EA
        0x26F2 0x26F3
        0x26F5 0x26F5
        0x26FA 0x26FA
        0x26FD 0x26FD
        0x2705 0x2705
        0x270A 0x270B
        0x2728 0x2728
        0x274C 0x274C
        0x274E 0x274E
        0x2753 0x2755
        0x2757 0x2757
        0x2795 0x2797
