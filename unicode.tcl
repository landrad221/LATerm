
namespace eval ::laterm::unicode {
    namespace export charWidth codepoint

    proc codepoint {char} {
        if {[string length $char] == 0} {
            error "empty character"
        }

        scan $char %c cp
        return $cp
    }

    proc inRanges {cp ranges} {
        foreach {first last} $ranges {
            if {$cp >= $first && $cp <= $last} {
                return 1
            }
        }
        return 0
    }

    variable combiningRanges {
        0x0300 0x036F
        0x0483 0x0489
        0x0591 0x05BD
        0x05BF 0x05BF
        0x05C1 0x05C2
        0x0610 0x061A
        0x064B 0x065F
        0x0670 0x0670
