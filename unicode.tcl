        0x27BF 0x27BF
        0x2B1B 0x2B1C
        0x2B50 0x2B50
        0x2B55 0x2B55
        0x2E80 0xA4CF
        0xAC00 0xD7A3
        0xF900 0xFAFF
        0xFE10 0xFE19
        0xFE30 0xFE6F
        0xFF00 0xFF60
        0xFFE0 0xFFE6
        0x1F300 0x1F64F
        0x1F680 0x1F6FF
        0x1F900 0x1F9FF
        0x1FA70 0x1FAFF
        0x20000 0x3FFFD
    }

    proc charWidth {char} {
        variable combiningRanges
        variable wideRanges

        set cp [codepoint $char]

        # C0/C1 controls are not printable.
        if {$cp < 0x20 ||
            ($cp >= 0x7F && $cp < 0xA0)} {
            return 0
        }

        if {[inRanges $cp $combiningRanges]} {
            return 0
        }

        if {[inRanges $cp $wideRanges]} {
            return 2
        }

        return 1
    }
}

