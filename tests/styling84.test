
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root "render/screen.tcl"]
source [file join $root parser.tcl]
source [file join $root "render/screen_adapter.tcl"]

proc stylingPipeline {} {
    set s [::laterm::Screen new 2 20]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]
    return [list $s $a $p]
}

proc stylingCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test styling-1.1 {standard foreground color} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[31mRED"
    set result [dict get [$s cell 0 0] fg]

    stylingCleanup $objects
    set result
} -result "#800000"

test styling-1.2 {SGR reset} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[31mR\033\[0mN"

    set result [list \
        [dict get [$s cell 0 0] fg] \
        [dict get [$s cell 0 1] fg]]

    stylingCleanup $objects
    set result
} -result {{#800000} default}

test styling-1.3 {bold and underline} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[1;4mX"

    set cell [$s cell 0 0]
    set result [list \
        [dict get $cell bold] \
        [dict get $cell underline]]

    stylingCleanup $objects
    set result
} -result {1 1}

test styling-1.4 {256-color foreground} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[38;5;196mX"
    set result [dict get [$s cell 0 0] fg]

    stylingCleanup $objects
    set result
} -result "#ff0000"

test styling-1.5 {truecolor background} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[48;2;20;40;60mX"
    set result [dict get [$s cell 0 0] bg]

    stylingCleanup $objects
    set result
} -result "#14283c"

test styling-1.6 {inverse video} -body {
    set objects [stylingPipeline]
    lassign $objects s a p

    $p feed "\033\[7mX"
    set result [dict get [$s cell 0 0] inverse]

    stylingCleanup $objects
    set result
} -result 1

::tcltest::cleanupTests

