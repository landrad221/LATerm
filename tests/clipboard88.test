
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root screen.tcl]
source [file join $root parser.tcl]
source [file join $root screen_adapter.tcl]
source [file join $root clipboard_controller.tcl]

proc clipboardPipeline {} {
    set s [::laterm::Screen new 5 20]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]
    set c [::LATerm::ClipboardController new $s]

    return [list $s $a $p $c]
}

proc clipboardCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test clipboard-1.1 {bracketed paste initially disabled} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    set result [$s bracketedPaste]

    clipboardCleanup $objects
    set result
} -result 0

test clipboard-1.2 {enable bracketed paste via CSI} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $p feed "\033\[?2004h"
    set result [$s bracketedPaste]

    clipboardCleanup $objects
    set result
} -result 1

test clipboard-1.3 {disable bracketed paste via CSI} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $p feed "\033\[?2004h"
    $p feed "\033\[?2004l"

    set result [$s bracketedPaste]

    clipboardCleanup $objects
    set result
} -result 0

test clipboard-1.4 {ordinary paste} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    set result [binary encode hex [$c encodePaste "hello"]]

    clipboardCleanup $objects
    set result
} -result 68656c6c6f

test clipboard-1.5 {bracketed paste delimiters} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $s setBracketedPaste 1
    set result [binary encode hex [$c encodePaste "hello"]]

    clipboardCleanup $objects
    set result
} -result 1b5b3230307e68656c6c6f1b5b3230317e

test clipboard-1.6 {multiline paste} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $s setBracketedPaste 1
    set result [$c encodePaste "first\nsecond"]

    clipboardCleanup $objects
    set result
} -result "\033\[200~first\nsecond\033\[201~"

test clipboard-1.7 {UTF-8 paste} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    set result [binary encode hex [$c encodePaste "é中"]]

    clipboardCleanup $objects
    set result
} -result c3a9e4b8ad

test clipboard-1.8 {empty paste produces no bytes} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $s setBracketedPaste 1
    set result [$c encodePaste ""]

    clipboardCleanup $objects
    set result
} -result {}

test clipboard-1.9 {bracketed paste does not modify screen} -body {
    set objects [clipboardPipeline]
    lassign $objects s a p c

    $p feed "HELLO"
    set before [$s dump]

    $p feed "\033\[?2004h"
    $c encodePaste "world"

    set result [expr {$before eq [$s dump]}]

    clipboardCleanup $objects
    set result
} -result 1

::tcltest::cleanupTests
