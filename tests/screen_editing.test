
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. "render/screen.tcl"]

test screen-editing-001 {erase line from cursor} -body {
    set s [::LATerm::Screen new 1 5]
    $s print "ABCDE"
    $s moveCursor 0 2
    $s eraseInLine 0

    set result [$s dump]
    $s destroy
    set result
} -result "AB   "

test screen-editing-002 {erase entire display} -body {
    set s [::LATerm::Screen new 2 3]
    $s print "ABCDEF"
    $s eraseInDisplay 2

    set result [list [$s dump] [$s cursor]]
    $s destroy
    set result
} -result [list "   \n   " {1 2}]

test screen-editing-003 {erase characters} -body {
    set s [::LATerm::Screen new 1 6]
    $s print "ABCDEF"
    $s moveCursor 0 2
    $s eraseCharacters 2

    set result [$s dump]
    $s destroy
    set result
} -result "AB  EF"

test screen-editing-004 {insert characters} -body {
    set s [::LATerm::Screen new 1 6]
    $s print "ABCDEF"
    $s moveCursor 0 2
    $s insertCharacters 2

    set result [$s dump]
    $s destroy
    set result
} -result "AB  CD"

test screen-editing-005 {delete characters} -body {
    set s [::LATerm::Screen new 1 6]
    $s print "ABCDEF"
    $s moveCursor 0 2
    $s deleteCharacters 2

    set result [$s dump]
    $s destroy
    set result
} -result "ABEF  "

test screen-editing-006 {insert line in region} -body {
    set s [::LATerm::Screen new 5 3]
    $s print "AAABBBCCCDDDEEE"

    $s setScrollRegion 1 3
    $s moveCursor 2 0
    $s insertLines 1

    set result [$s dump]
    $s destroy
    set result
} -result "AAA\nBBB\n   \nCCC\nEEE"

test screen-editing-007 {delete line in region} -body {
    set s [::LATerm::Screen new 5 3]
    $s print "AAABBBCCCDDDEEE"

    $s setScrollRegion 1 3
    $s moveCursor 2 0
    $s deleteLines 1

    set result [$s dump]
    $s destroy
    set result
} -result "AAA\nBBB\nDDD\n   \nEEE"

test screen-editing-008 {line editing outside region} -body {
    set s [::LATerm::Screen new 5 3]
    $s print "AAABBBCCCDDDEEE"

    $s setScrollRegion 1 3
    $s moveCursor 4 1
    $s insertLines 1
    $s deleteLines 1

    set result [$s dump]
    $s destroy
    set result
} -result "AAA\nBBB\nCCC\nDDD\nEEE"

test screen-editing-009 {count zero means one} -body {
    set s [::LATerm::Screen new 1 5]
    $s print "ABCDE"
    $s moveCursor 0 1
    $s deleteCharacters 0

    set result [$s dump]
    $s destroy
    set result
} -result "ACDE "

test screen-editing-010 {erase before cursor} -body {
    set s [::LATerm::Screen new 2 4]
    $s print "ABCDEFGH"
    $s moveCursor 1 1
    $s eraseInDisplay 1

    set result [$s dump]
    $s destroy
    set result
} -result "    \n  GH"

::tcltest::cleanupTests
