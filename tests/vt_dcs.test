
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root parser.tcl]
source [file join $root render/screen_adapter.tcl]

proc vtPipeline {} {
    set s [::laterm::Screen new 24 80]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]

    return [list $s $a $p]
}

proc vtCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

proc vtRow {screen row} {
    set result ""
    lassign [$screen dimensions] rows cols

    for {set col 0} {$col < $cols} {incr col} {
        set cell [$screen cell $row $col]

        if {[dict get $cell width] == 0} {
            continue
        }

        set text [dict get $cell text]

        if {$text eq ""} {
            set text " "
        }

        append result $text
    }

    return $result
}

test vt-dcs-001 {DCS payload is not printed} -body {
    set objects [vtPipeline]
    lassign $objects s a p

    $p feed "BEFORE"
    $p feed "\033Pzz\033\\"
    $p feed "AFTER"

    set result [string range [vtRow $s 0] 0 10]

    vtCleanup $objects
    set result
} -result "BEFOREAFTER"

test vt-dcs-002 {DCS survives split feed calls} -body {
    set objects [vtPipeline]
    lassign $objects s a p

    $p feed "A\033P"
    $p feed "test"
    $p feed "\033"
    $p feed "\\B"

    set result [string range [vtRow $s 0] 0 1]

    vtCleanup $objects
    set result
} -result "AB"

test vt-dcs-003 {CAN cancels DCS} -body {
    set objects [vtPipeline]
    lassign $objects s a p

    $p feed "A\033Pignored\030B"

    set result [string range [vtRow $s 0] 0 1]

    vtCleanup $objects
    set result
} -result "AB"

::tcltest::cleanupTests
