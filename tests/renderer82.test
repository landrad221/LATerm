
package require tcltest 2
package require Tk

namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. "render/screen.tcl"]

source [file join \
    [file dirname [info script]] .. "render/tk_renderer.tcl"]

test renderer-1.1 {initial render} -body {
    text .test1
    set s [::laterm::Screen new 2 5]
    set r [::laterm::TkRenderer new .test1 $s]

    $s print "HELLO"
    $r renderDirty

    set result [.test1 get 1.0 1.end]

    $r destroy
    $s destroy
    destroy .test1

    set result
} -result HELLO

test renderer-1.2 {dirty row update} -body {
    text .test2
    set s [::laterm::Screen new 2 5]
    set r [::laterm::TkRenderer new .test2 $s]

    $s moveCursor 1 0
    $s print "WORLD"
    $r renderDirty

    set result [.test2 get 2.0 2.end]

    $r destroy
    $s destroy
    destroy .test2

    set result
} -result WORLD

test renderer-1.3 {Unicode column mapping} -body {
    text .test3
    set s [::laterm::Screen new 1 6]
    set r [::laterm::TkRenderer new .test3 $s]

    $s print "A中B"

    set result [$r columnToIndex 0 3]

    $r destroy
    $s destroy
    destroy .test3

    set result
} -result 2

test renderer-1.4 {dirty state consumed} -body {
    text .test4
    set s [::laterm::Screen new 2 5]
    set r [::laterm::TkRenderer new .test4 $s]

    $s print "HELLO"
    $r renderDirty

    set changes [$s peekDirty]
    set result [dict size [dict get $changes rows]]

    $r destroy
    $s destroy
    destroy .test4

    set result
} -result 0

test renderer-1.5 {wide characters render correctly} -body {
    text .test5
    set s [::laterm::Screen new 1 6]
    set r [::laterm::TkRenderer new .test5 $s]

    $s print "A中B"
    $r renderDirty

    set result [.test5 get 1.0 1.end]

    $r destroy
    $s destroy
    destroy .test5

    set result
} -result "A中B  "

::tcltest::cleanupTests

