
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. unicode.tcl]

test unicode-001 {ASCII width} -body {
    ::LATerm::unicode::charWidth A
} -result 1

test unicode-002 {Latin accented character} -body {
    ::LATerm::unicode::charWidth é
} -result 1

test unicode-003 {CJK wide character} -body {
    ::LATerm::unicode::charWidth 中
} -result 2

test unicode-004 {another CJK character} -body {
    ::LATerm::unicode::charWidth 界
} -result 2

test unicode-005 {combining acute accent} -body {
    ::LATerm::unicode::charWidth "\u0301"
} -result 0

test unicode-006 {emoji} -body {
    ::LATerm::unicode::charWidth 😀
} -result 2

test unicode-007 {control character} -body {
    ::LATerm::unicode::charWidth "\n"
} -result 0

test unicode-008 {ASCII digit} -body {
    ::LATerm::unicode::charWidth 7
} -result 1

test unicode-009 {variation selector} -body {
    ::LATerm::unicode::charWidth "\uFE0F"
} -result 0

::tcltest::cleanupTests

