
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. unicode.tcl]

test unicode-1.1 {ASCII width} -body {
    ::laterm::unicode::charWidth A
} -result 1

test unicode-1.2 {Latin accented character} -body {
    ::laterm::unicode::charWidth é
} -result 1

test unicode-1.3 {CJK wide character} -body {
    ::laterm::unicode::charWidth 中
} -result 2

test unicode-1.4 {another CJK character} -body {
    ::laterm::unicode::charWidth 界
} -result 2

test unicode-1.5 {combining acute accent} -body {
    ::laterm::unicode::charWidth "\u0301"
} -result 0

test unicode-1.6 {emoji} -body {
    ::laterm::unicode::charWidth 😀
} -result 2

test unicode-1.7 {control character} -body {
    ::laterm::unicode::charWidth "\n"
} -result 0

test unicode-1.8 {ASCII digit} -body {
    ::laterm::unicode::charWidth 7
} -result 1

test unicode-1.9 {variation selector} -body {
    ::laterm::unicode::charWidth "\uFE0F"
} -result 0

::tcltest::cleanupTests

