
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. "render/screen.tcl"]

test screen-alternate-buffer-001 {initial screen is primary} -body {
    set s [::LATerm::Screen new 2 5]
    set result [$s activeScreen]
    $s destroy
    set result
} -result primary

test screen-alternate-buffer-002 {alternate screen starts blank} -body {
    set s [::LATerm::Screen new 2 5]
    $s print "HELLO"
    $s enterAlternate

    set result [list [$s activeScreen] [$s dump]]
    $s destroy
    set result
} -result [list alternate "     \n     "]

test screen-alternate-buffer-003 {primary content restored} -body {
    set s [::LATerm::Screen new 2 5]
    $s print "HELLO"
    $s enterAlternate
    $s print "WORLD"
    $s leaveAlternate

    set result [$s dump]
    $s destroy
    set result
} -result "HELLO\n     "

test screen-alternate-buffer-004 {cursor restored} -body {
    set s [::LATerm::Screen new 3 10]
    $s moveCursor 2 7
    $s enterAlternate
    $s moveCursor 1 3
    $s leaveAlternate

    set result [$s cursor]
    $s destroy
    set result
} -result {2 7}

test screen-alternate-buffer-005 {alternate buffer persists} -body {
    set s [::LATerm::Screen new 2 8]
    $s enterAlternate
    $s print "EDITOR"
    $s leaveAlternate
    $s enterAlternate

    set result [$s dump]
    $s destroy
    set result
} -result "EDITOR  \n        "

test screen-alternate-buffer-006 {switch marks full screen dirty} -body {
    set s [::LATerm::Screen new 2 4]
    $s consumeDirty
    $s enterAlternate

    set result [dict get [$s consumeDirty] rows]
    $s destroy
    set result
} -result {0 {{0 3}} 1 {{0 3}}}

test screen-alternate-buffer-007 {repeated switching is harmless} -body {
    set s [::LATerm::Screen new 2 4]
    $s enterAlternate
    $s enterAlternate
    $s leaveAlternate
    $s leaveAlternate

    set result [$s activeScreen]
    $s destroy
    set result
} -result primary

::tcltest::cleanupTests

