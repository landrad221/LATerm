
package require Tcl 8.6
package require tcltest 2

namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]
source [file join $root pty_writer.tcl]

proc bpCreate {{limit 1048576}} {
    lassign [chan pipe] reader sender

    fconfigure $reader \
        -blocking 0 \
        -translation binary \
        -encoding binary

    fconfigure $sender \
        -blocking 0 \
        -translation binary \
        -encoding binary \
        -buffering none

    set writer [::LATerm::PtyWriter new $sender $limit]

    return [list $reader $sender $writer]
}

proc bpCleanup {objects} {
    lassign $objects reader sender writer

    catch {$writer destroy}
    catch {close $sender}
    catch {close $reader}
}

# Advance the Tcl event loop a bounded number of times.
proc bpPump {{iterations 100}} {
    for {set i 0} {$i < $iterations} {incr i} {
        update
    }
}

# Read until the requested number of bytes is received,
# or until the timeout expires.
proc bpReceive {reader expected {timeout 5000}} {
    set result ""
    set deadline [expr {[clock milliseconds] + $timeout}]

    while {[string bytelength $result] < $expected &&
           [clock milliseconds] < $deadline} {

        update

        set chunk [read $reader 65536]

        if {$chunk ne ""} {
            append result $chunk
        }

        after 1
    }

    return $result
}

test pty-backpressure-1.1 {stalled reader retains pending data} -body {
    set objects [bpCreate 1048576]
    lassign $objects reader sender writer

    set payload [string repeat "A" 524288]

    $writer send $payload

    # Do not read from the pipe.
    bpPump 100

    set pending [$writer pending]

    set result [expr {
        $pending > 0 &&
        $pending <= 1048576
    }]

    bpCleanup $objects
    set result
} -result 1

test pty-backpressure-1.2 {writer resumes after reader drains} -body {
    set objects [bpCreate 1048576]
    lassign $objects reader sender writer

    set payload [string repeat "B" 524288]

    $writer send $payload

    bpPump 100

    set received [bpReceive $reader [string bytelength $payload]]

    set result [expr {$received eq $payload}]

    bpCleanup $objects
    set result
} -result 1

test pty-backpressure-1.3 {FIFO preserved during backpressure} -body {
    set objects [bpCreate 1048576]
    lassign $objects reader sender writer

    set first  [string repeat "A" 131072]
    set second [string repeat "B" 131072]
    set third  [string repeat "C" 131072]

    $writer send $first
    $writer send $second
    $writer send $third

    bpPump 100

    set expected "${first}${second}${third}"
    set received [bpReceive $reader [string bytelength $expected]]

    set result [expr {$received eq $expected}]

    bpCleanup $objects
    set result
} -result 1

test pty-backpressure-1.4 {pending limit rejects excess data} -body {
    set objects [bpCreate 65536]
    lassign $objects reader sender writer

    set limit 65536

    # Queue the entire allowance without running
    # the event loop.
    $writer send [string repeat "A" $limit]

    set before [$writer pending]

    # This must exceed the configured limit.
    set failed [catch {
        $writer send "B"
    } message]

    set after [$writer pending]

    set result [list \
        $before \
        $failed \
        $message \
        $after]

    bpCleanup $objects

    set result
} -result {65536 1 {PTY writer pending limit exceeded} 65536}

test pty-backpressure-1.5 {destroy while backpressured} -body {
    set objects [bpCreate 1048576]
    lassign $objects reader sender writer

    $writer send [string repeat "X" 524288]

    bpPump 100

    $writer destroy

    set failed [catch {
        update
    } message]

    catch {close $sender}
    catch {close $reader}

    set failed
} -result 0


test pty-backpressure-1.6 {
    writable callback registers under backpressure
    and unregisters after recovery
} -body {
    set objects [bpCreate 1048576]
    lassign $objects reader sender writer

    set payload [string repeat "W" 524288]
    set expected [string bytelength $payload]

    $writer send $payload

    # Stall the reader. Only idle callbacks are run,
    # so the pipe eventually fills.
    for {set i 0} {$i < 1000} {incr i} {
        update idletasks

        if {[fileevent $sender writable] ne ""} {
            break
        }
    }

    set armed [expr {
        [fileevent $sender writable] ne ""
    }]

    # Resume reading and allow writable events to fire.
    set received ""
    set deadline [expr {[clock milliseconds] + 5000}]

    while {
        [string bytelength $received] < $expected &&
        [clock milliseconds] < $deadline
    } {
        update

        set chunk [read $reader 65536]

        if {$chunk ne ""} {
            append received $chunk
        }

        after 1
    }

    # Give the writer an opportunity to finish cleanup.
    update idletasks

    set delivered [expr {
        $received eq $payload
    }]

    set drained [expr {
        [$writer pending] == 0
    }]

    set disarmed [expr {
        [fileevent $sender writable] eq ""
    }]

    set result [list \
        $armed \
        $delivered \
        $drained \
        $disarmed]

    bpCleanup $objects

    set result
} -result {1 1 1 1}


::tcltest::cleanupTests
