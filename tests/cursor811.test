
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root parser.tcl]
source [file join $root render/screen_adapter.tcl]

proc cursorPipeline {} {
    set s [::laterm::Screen new 24 80]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]

    return [list $s $a $p]
}

proc cursorCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test cursor-1.1 {default cursor style} -body {
    set s [::laterm::Screen new 24 80]

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    $s destroy
    set result
} -result {1 block 1}

test cursor-1.2 {steady block cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[2 q"

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    cursorCleanup $objects
    set result
} -result {2 block 0}

test cursor-1.3 {blinking underline cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[3 q"

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    cursorCleanup $objects
    set result
} -result {3 underline 1}

test cursor-1.4 {steady underline cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[4 q"

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    cursorCleanup $objects
    set result
} -result {4 underline 0}

test cursor-1.5 {blinking bar cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[5 q"

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    cursorCleanup $objects
    set result
} -result {5 bar 1}

test cursor-1.6 {steady bar cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[6 q"

    set result [list [$s cursorStyle] [$s cursorShape] \
        [$s cursorBlinking]]

    cursorCleanup $objects
    set result
} -result {6 bar 0}

test cursor-1.7 {invalid cursor style is ignored} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[2 q"
    $p feed "\033\[9 q"

    set result [$s cursorStyle]

    cursorCleanup $objects
    set result
} -result 2

test cursor-1.8 {empty parameter selects default cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[6 q"
    $p feed "\033\[ q"

    set result [$s cursorStyle]

    cursorCleanup $objects
    set result
} -result 0

::tcltest::cleanupTests
