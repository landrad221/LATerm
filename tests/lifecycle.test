
package require Tcl 8.6
package require tcltest 2

namespace import ::tcltest::test

proc cancelLifecycleTimer {variableName} {
    upvar #0 $variableName timerId

    if {$timerId ne ""} {
        after cancel $timerId
        set timerId ""
    }
}

test lifecycle-001 {cancel scheduled callback} -body {
    set ::lifecycleExecuted 0

    set ::lifecycleTimer [after 0 {
        set ::lifecycleExecuted 1
    }]

    cancelLifecycleTimer ::lifecycleTimer

    update

    set result [list \
        $::lifecycleExecuted \
        $::lifecycleTimer]

    unset ::lifecycleExecuted
    unset ::lifecycleTimer

    set result
} -result {0 {}}

test lifecycle-002 {cancellation is idempotent} -body {
    set ::lifecycleTimer [after 10000 { }]

    set failed [catch {
        cancelLifecycleTimer ::lifecycleTimer
        cancelLifecycleTimer ::lifecycleTimer
    }]

    unset ::lifecycleTimer

    set failed
} -result 0

::tcltest::cleanupTests
