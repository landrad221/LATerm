
package require tcltest 2
package require Tk

namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root render/tk_renderer.tcl]

test cursor-renderer-001 {cursor tag at initial position} -body {
    text .cursorTest

    set s [::laterm::Screen new 2 10]
    set r [::laterm::TkRenderer new .cursorTest $s]

    set ranges [.cursorTest tag ranges latermCursor]

    $r destroy
    $s destroy
    destroy .cursorTest

    set ranges
} -result {1.0 1.1}

test cursor-renderer-002 {cursor moves to new position} -body {
    text .cursorTest

    set s [::laterm::Screen new 2 10]
    set r [::laterm::TkRenderer new .cursorTest $s]

    $s moveCursor 1 4
    $r renderDirty

    set ranges [.cursorTest tag ranges latermCursor]

    $r destroy
    $s destroy
    destroy .cursorTest

    set ranges
} -result {2.4 2.5}

test cursor-renderer-003 {hidden cursor has no tag range} -body {
    text .cursorTest

    set s [::laterm::Screen new 2 10]
    set r [::laterm::TkRenderer new .cursorTest $s]

    $s setCursorVisible 0
    $r renderDirty

    set ranges [.cursorTest tag ranges latermCursor]

    $r destroy
    $s destroy
    destroy .cursorTest

    set ranges
} -result {}

::tcltest::cleanupTests
