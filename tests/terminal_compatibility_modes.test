
package require Tcl 8.6
package require tcltest 2

namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root parser.tcl]
source [file join $root render/screen_adapter.tcl]

namespace eval ::terminalCompatibilityModes {
    variable responses {}
}

proc ::terminalCompatibilityModes::capture {bytes} {
    variable responses
    lappend responses $bytes
}

proc ::terminalCompatibilityModes::pipeline {} {
    variable responses
    set responses {}

    set screen [::laterm::Screen new 10 20]

    set adapter [::LATerm::ScreenAdapter new \
        $screen ::terminalCompatibilityModes::capture]

    set parser [::LATerm::Parser new \
        [list $adapter event]]

    return [list $screen $adapter $parser]
}

proc ::terminalCompatibilityModes::cleanup {objects} {
    foreach object [lreverse $objects] {
        catch {$object destroy}
    }
}

test terminal-compatibility-modes-001 {cursor visibility hide and show} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    set initial [$screen cursorVisible]

    $parser feed "\033\[?25l"
    set hidden [$screen cursorVisible]

    $parser feed "\033\[?25h"
    set restored [$screen cursorVisible]

    ::terminalCompatibilityModes::cleanup $objects

    list $initial $hidden $restored
} -result {1 0 1}

test terminal-compatibility-modes-002 {split cursor visibility sequence} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[?"
    $parser feed "25"
    $parser feed "l"

    set result [$screen cursorVisible]

    ::terminalCompatibilityModes::cleanup $objects
    set result
} -result 0

test terminal-compatibility-modes-003 {DSR returns one-based coordinates} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[4;9H"
    $parser feed "\033\[6n"

    set result $::terminalCompatibilityModes::responses

    ::terminalCompatibilityModes::cleanup $objects
    set result
} -result [list "\033\[4;9R"]

test terminal-compatibility-modes-004 {split DSR produces one response} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[6"
    set before $::terminalCompatibilityModes::responses

    $parser feed "n"
    set after $::terminalCompatibilityModes::responses

    ::terminalCompatibilityModes::cleanup $objects

    list $before $after
} -result [list {} [list "\033\[1;1R"]]

test terminal-compatibility-modes-005 {DA and DSR do not modify display} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "HELLO"
    set before [$screen dump]

    $parser feed "\033\[c"
    $parser feed "\033\[5n"
    $parser feed "\033\[6n"

    set after [$screen dump]
    set responses $::terminalCompatibilityModes::responses

    ::terminalCompatibilityModes::cleanup $objects

    list [expr {$before eq $after}] $responses
} -result [list 1 [list \
    "\033\[?1;2c" "\033\[0n" "\033\[1;6R"]]

test terminal-compatibility-modes-006 {alternate screen restores cursor} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[3;7H"
    set before [$screen cursor]

    $parser feed "\033\[?1049h"
    $parser feed "\033\[8;12H"
    $parser feed "\033\[?1049l"

    set after [$screen cursor]

    ::terminalCompatibilityModes::cleanup $objects

    list $before $after
} -result {{2 6} {2 6}}

test terminal-compatibility-modes-007 {cursor visibility survives screen changes} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[?25l"
    $parser feed "\033\[2J"
    $parser feed "\033\[5;10H"
    $parser feed "TEXT"

    set result [$screen cursorVisible]

    ::terminalCompatibilityModes::cleanup $objects
    set result
} -result 0

test terminal-compatibility-modes-008 {unknown DSR produces no response} -body {
    set objects [::terminalCompatibilityModes::pipeline]
    lassign $objects screen adapter parser

    $parser feed "\033\[99n"

    set result $::terminalCompatibilityModes::responses

    ::terminalCompatibilityModes::cleanup $objects
    set result
} -result {}

::tcltest::cleanupTests
