
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root keyboard_encoder.tcl]

proc keyboardPipeline {} {
    set s [::laterm::Screen new 5 20]
    set k [::LATerm::KeyboardEncoder new $s]
    return [list $s $k]
}

proc keyboardCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test keyboard-encoder-001 {normal cursor up} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode Up ""]

    keyboardCleanup $objects
    set result
} -result "\033\[A"

test keyboard-encoder-002 {application cursor up} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    $s setApplicationCursorKeys 1
    set result [$k encode Up ""]

    keyboardCleanup $objects
    set result
} -result "\033OA"

test keyboard-encoder-003 {Ctrl+Up} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode Up "" 0 0 1]

    keyboardCleanup $objects
    set result
} -result "\033\[1;5A"

test keyboard-encoder-004 {Shift+Right} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode Right "" 1 0 0]

    keyboardCleanup $objects
    set result
} -result "\033\[1;2C"

test keyboard-encoder-005 {Delete key} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode Delete ""]

    keyboardCleanup $objects
    set result
} -result "\033\[3~"

test keyboard-encoder-006 {F5 key} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode F5 ""]

    keyboardCleanup $objects
    set result
} -result "\033\[15~"

test keyboard-encoder-007 {Ctrl+C} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [binary encode hex [$k encode c "" 0 0 1]]

    keyboardCleanup $objects
    set result
} -result 03

test keyboard-encoder-008 {Alt+x} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode x x 0 1 0]

    keyboardCleanup $objects
    set result
} -result "\033x"

test keyboard-encoder-009 {UTF-8 input} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set output [$k encode eacute é]
    set result [binary encode hex \
        [encoding convertto utf-8 $output]]

    keyboardCleanup $objects
    set result
} -result c3a9

test keyboard-encoder-010 {Ctrl+Shift+Left} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    set result [$k encode Left "" 1 0 1]

    keyboardCleanup $objects
    set result
} -result "\033\[1;6D"

test keyboard-encoder-011 {DECSET application cursor mode} -body {
    set objects [keyboardPipeline]
    lassign $objects s k

    $s setPrivateMode 1 1
    set enabled [$k encode Down ""]

    $s setPrivateMode 1 0
    set disabled [$k encode Down ""]

    keyboardCleanup $objects
    list $enabled $disabled
} -result [list "\033OB" "\033\[B"]

::tcltest::cleanupTests
