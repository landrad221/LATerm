
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root "render/screen.tcl"]
source [file join $root "parser.tcl"]
source [file join $root "render/screen_adapter.tcl"]

proc cursorPipeline {} {
    set s [::laterm::Screen new 3 10]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]

    return [list $s $a $p]
}

proc cursorCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test cursor-1.1 {cursor initially visible} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    set result [$s cursorVisible]

    cursorCleanup $objects
    set result
} -result 1

test cursor-1.2 {hide cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[?25l"
    set result [$s cursorVisible]

    cursorCleanup $objects
    set result
} -result 0

test cursor-1.3 {show cursor} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[?25l"
    $p feed "\033\[?25h"

    set result [$s cursorVisible]

    cursorCleanup $objects
    set result
} -result 1

test cursor-1.4 {visibility change marks cursor dirty} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $s consumeDirty
    $p feed "\033\[?25l"

    set result [dict get [$s peekDirty] cursor]

    cursorCleanup $objects
    set result
} -result 1

test cursor-1.5 {ESC 7 and ESC 8 save and restore} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "\033\[2;5H"
    $p feed "\0337"
    $p feed "\033\[3;9H"
    $p feed "\0338"

    set result [$s cursor]

    cursorCleanup $objects
    set result
} -result {1 4}

test cursor-1.6 {cursor visibility does not change text} -body {
    set objects [cursorPipeline]
    lassign $objects s a p

    $p feed "HELLO"
    set before [$s dump]

    $p feed "\033\[?25l"
    $p feed "\033\[?25h"

    set result [expr {$before eq [$s dump]}]

    cursorCleanup $objects
    set result
} -result 1

::tcltest::cleanupTests
