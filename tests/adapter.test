
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root "render/screen.tcl"]
source [file join $root parser.tcl]
source [file join $root "render/screen_adapter.tcl"]

proc createPipeline {rows cols} {
    set screen [::laterm::Screen new $rows $cols]
    set adapter [::LATerm::ScreenAdapter new $screen]
    set parser [::LATerm::Parser new [list $adapter event]]

    return [list $screen $adapter $parser]
}

proc destroyPipeline {pipeline} {
    foreach obj [lreverse $pipeline] {
        $obj destroy
    }
}

test adapter-001 {ordinary text} -body {
    set pipeline [createPipeline 2 10]
    lassign $pipeline s a p

    $p feed "Hello"
    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "Hello     \n          "

test adapter-002 {carriage return} -body {
    set pipeline [createPipeline 1 10]
    lassign $pipeline s a p

    $p feed "HELLO\rX"
    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "XELLO     "

test adapter-003 {cursor positioning} -body {
    set pipeline [createPipeline 3 10]
    lassign $pipeline s a p

    $p feed "\033\[2;4H"
    $p feed "X"

    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "          \n   X      \n          "

test adapter-004 {erase display} -body {
    set pipeline [createPipeline 2 10]
    lassign $pipeline s a p

    $p feed "Hello"
    $p feed "\033\[2J"

    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "          \n          "

test adapter-005 {split UTF-8 sequence} -body {
    set pipeline [createPipeline 1 10]
    lassign $pipeline s a p

    set bytes [encoding convertto utf-8 "中"]

    $p feed [string range $bytes 0 0]
    $p feed [string range $bytes 1 end]

    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "中        "

test adapter-006 {alternate screen} -body {
    set pipeline [createPipeline 2 10]
    lassign $pipeline s a p

    $p feed "SHELL"
    $p feed "\033\[?1049h"
    $p feed "EDITOR"
    $p feed "\033\[?1049l"

    set result [$s dump]

    destroyPipeline $pipeline
    set result
} -result "SHELL     \n          "

::tcltest::cleanupTests

