
package require tcltest 2
namespace import ::tcltest::test

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root parser.tcl]
source [file join $root render/screen_adapter.tcl]
source [file join $root render/mouse_encoder.tcl]

proc mousePipeline {} {
    set s [::laterm::Screen new 24 80]
    set a [::LATerm::ScreenAdapter new $s]
    set p [::LATerm::Parser new [list $a event]]
    set m [::LATerm::MouseEncoder new $s]

    return [list $s $a $p $m]
}

proc mouseCleanup {objects} {
    foreach obj [lreverse $objects] {
        $obj destroy
    }
}

test mouse-1.1 {mouse reporting initially disabled} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    set result [$s mouseReportingEnabled]

    mouseCleanup $objects
    set result
} -result 0

test mouse-1.2 {enable mode 1000 via parser} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $p feed "\033\[?1000h"
    set result [$s mouseTrackingMode]

    mouseCleanup $objects
    set result
} -result 1000

test mouse-1.3 {disable mode 1000} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $p feed "\033\[?1000h"
    $p feed "\033\[?1000l"

    set result [$s mouseReportingEnabled]

    mouseCleanup $objects
    set result
} -result 0

test mouse-1.4 {SGR left mouse press} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set result [$m encode press 1 4 9]

    mouseCleanup $objects
    set result
} -result "\033\[<0;10;5M"

test mouse-1.5 {SGR left mouse release} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set result [$m encode release 1 4 9]

    mouseCleanup $objects
    set result
} -result "\033\[<0;10;5m"

test mouse-1.6 {SGR right mouse press} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set result [$m encode press 3 0 0]

    mouseCleanup $objects
    set result
} -result "\033\[<2;1;1M"

test mouse-1.7 {Ctrl+Shift mouse press} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set result [$m encode press 1 2 3 1 0 1]

    mouseCleanup $objects
    set result
} -result "\033\[<20;4;3M"

test mouse-1.8 {drag requires mode 1002 or 1003} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set before [$m encode drag 1 2 3]

    $s setMouseMode 1002 1
    set after [$m encode drag 1 2 3]

    mouseCleanup $objects
    list $before $after
} -result [list "" "\033\[<32;4;3M"]

test mouse-1.9 {motion requires mode 1003} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1002 1
    $s setMouseMode 1006 1

    set before [$m encode move 0 2 3]

    $s setMouseMode 1003 1
    set after [$m encode move 0 2 3]

    mouseCleanup $objects
    list $before $after
} -result [list "" "\033\[<35;4;3M"]

test mouse-1.10 {mouse wheel up and down} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set up [$m encode wheel-up 0 2 3]
    set down [$m encode wheel-down 0 2 3]

    mouseCleanup $objects
    list $up $down
} -result [list "\033\[<64;4;3M" "\033\[<65;4;3M"]

test mouse-1.11 {legacy X10 mouse encoding} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1

    set result [binary encode hex \
        [$m encode press 1 0 0]]

    mouseCleanup $objects
    set result
} -result 1b5b4d202121

test mouse-1.12 {out-of-bounds coordinates ignored} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $s setMouseMode 1000 1
    $s setMouseMode 1006 1

    set result [$m encode press 1 99 99]

    mouseCleanup $objects
    set result
} -result {}

test mouse-1.13 {mouse mode does not modify screen} -body {
    set objects [mousePipeline]
    lassign $objects s a p m

    $p feed "HELLO"
    set before [$s dump]

    $p feed "\033\[?1000h"
    $p feed "\033\[?1006h"

    $m encode press 1 0 0

    set result [expr {$before eq [$s dump]}]

    mouseCleanup $objects
    set result
} -result 1

::tcltest::cleanupTests
