
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. "render/screen.tcl"]

test screen-scrollback-001 {initial history is empty} -body {
    set s [::LATerm::Screen new 2 4 10]

    set result [list \
        [$s scrollbackSize] \
        [$s scrollbackLimit]]

    $s destroy
    set result
} -result {0 10}

test screen-scrollback-002 {full-screen scroll captures row} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollUp

    set result [list \
        [$s dumpScrollback] \
        [$s dump]]

    $s destroy
    set result
} -result [list "AAA" "BBB\n   "]

test screen-scrollback-003 {history respects limit} -body {
    set s [::LATerm::Screen new 2 3 2]

    $s print "AAABBB"
    $s scrollUp
    $s scrollUp
    $s scrollUp

    set result [list \
        [$s scrollbackSize] \
        [$s dumpScrollback]]

    $s destroy
    set result
} -result [list 2 "BBB\n   "]

test screen-scrollback-004 {alternate screen does not add history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s enterAlternate
    $s print "AAABBB"
    $s scrollUp
    $s leaveAlternate

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-005 {restricted region does not add history} -body {
    set s [::LATerm::Screen new 4 3 10]

    $s print "AAABBBCCCDDD"
    $s setScrollRegion 1 2
    $s scrollUp

    set result [list \
        [$s scrollbackSize] \
        [$s dump]]

    $s destroy
    set result
} -result [list 0 "AAA\nCCC\n   \nDDD"]

test screen-scrollback-006 {history retains Unicode cells} -body {
    set s [::LATerm::Screen new 2 4 10]

    $s print "中AB"
    $s scrollUp

    set row [$s scrollbackRow 0]

    set result [list \
        [dict get [lindex $row 0] text] \
        [dict get [lindex $row 0] width] \
        [dict get [lindex $row 1] width]]

    $s destroy
    set result
} -result [list 中 2 0]

test screen-scrollback-007 {clear history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollUp
    $s clearScrollback

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-008 {limit zero disables history} -body {
    set s [::LATerm::Screen new 2 3 0]

    $s print "AAABBB"
    $s scrollUp

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-009 {reducing limit trims oldest rows} -body {
    set s [::LATerm::Screen new 3 3 10]

    $s print "AAABBBCCC"
    $s scrollUp 2
    $s setScrollbackLimit 1

    set result [list \
        [$s scrollbackSize] \
        [$s dumpScrollback]]

    $s destroy
    set result
} -result [list 1 "BBB"]

test screen-scrollback-010 {scroll down does not add history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollDown

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-011 {viewport combines history and live rows} -body {
    set s [::LATerm::Screen new 2 3 10]
    $s print "AAABBB"
    $s scrollUp

    set live [lmap row {0 1} {$s visibleRowCells $row}]
    set offset [$s scrollViewport 1]
    set scrolled [lmap row {0 1} {$s visibleRowCells $row}]

    $s scrollViewport 100
    set clamped [list \
        [$s scrollbackOffset] \
        [dict get [lindex [$s visibleRowCells 0] 0] text]]
    $s scrollViewport -100
    set returned [list \
        [$s scrollbackOffset] \
        [dict get [lindex [$s visibleRowCells 0] 0] text]]

    $s destroy
    list \
        [dict get [lindex [lindex $live 0] 0] text] \
        $offset \
        [dict get [lindex [lindex $scrolled 0] 0] text] \
        [dict get [lindex [lindex $scrolled 1] 0] text] \
        $clamped \
        $returned
} -result [list "B" 1 "A" "B" [list 1 "A"] [list 0 "B"]]

test screen-scrollback-012 {history viewport stays anchored as output arrives} -body {
    set s [::LATerm::Screen new 2 3 10]
    $s print "AAABBB"
    $s scrollUp
    $s scrollViewport 1
    $s scrollUp

    set result [list \
        [$s scrollbackOffset] \
        [dict get [lindex [$s visibleRowCells 0] 0] text]]

    $s destroy
    set result
} -result [list 2 "A"]

test screen-scrollback-013 {clearing history returns viewport to live screen} -body {
    set s [::LATerm::Screen new 2 3 10]
    $s print "AAABBB"
    $s scrollUp
    $s scrollViewport 1
    $s clearScrollback

    set result [list \
        [$s scrollbackOffset] \
        [dict get [lindex [$s visibleRowCells 0] 0] text]]

    $s destroy
    set result
} -result [list 0 "B"]

test screen-scrollback-014 {cursor is hidden while displaying scrollback} -body {
    set s [::LATerm::Screen new 2 3 10]
    $s print "AAABBB"
    $s scrollUp
    $s scrollViewport 1
    set hidden [$s displayCursorVisible]
    $s scrollViewport -1
    set visible [$s displayCursorVisible]

    $s destroy
    list $hidden $visible
} -result {0 1}

test screen-scrollback-015 {alternate screen resets the history viewport} -body {
    set s [::LATerm::Screen new 2 3 10]
    $s print "AAABBB"
    $s scrollUp
    $s scrollViewport 1
    $s enterAlternate
    $s leaveAlternate

    set result [list \
        [$s scrollbackOffset] \
        [dict get [lindex [$s visibleRowCells 0] 0] text]]

    $s destroy
    set result
} -result [list 0 "B"]

::tcltest::cleanupTests
