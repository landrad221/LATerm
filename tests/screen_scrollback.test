
package require tcltest 2
namespace import ::tcltest::test

source [file join \
    [file dirname [info script]] .. "render/screen.tcl"]

test screen-scrollback-001 {initial history is empty} -body {
    set s [::LATerm::Screen new 2 4 10]

    set result [list \
        [$s scrollbackSize] \
        [$s scrollbackLimit]]

    $s destroy
    set result
} -result {0 10}

test screen-scrollback-002 {full-screen scroll captures row} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollUp

    set result [list \
        [$s dumpScrollback] \
        [$s dump]]

    $s destroy
    set result
} -result [list "AAA" "BBB\n   "]

test screen-scrollback-003 {history respects limit} -body {
    set s [::LATerm::Screen new 2 3 2]

    $s print "AAABBB"
    $s scrollUp
    $s scrollUp
    $s scrollUp

    set result [list \
        [$s scrollbackSize] \
        [$s dumpScrollback]]

    $s destroy
    set result
} -result [list 2 "BBB\n   "]

test screen-scrollback-004 {alternate screen does not add history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s enterAlternate
    $s print "AAABBB"
    $s scrollUp
    $s leaveAlternate

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-005 {restricted region does not add history} -body {
    set s [::LATerm::Screen new 4 3 10]

    $s print "AAABBBCCCDDD"
    $s setScrollRegion 1 2
    $s scrollUp

    set result [list \
        [$s scrollbackSize] \
        [$s dump]]

    $s destroy
    set result
} -result [list 0 "AAA\nCCC\n   \nDDD"]

test screen-scrollback-006 {history retains Unicode cells} -body {
    set s [::LATerm::Screen new 2 4 10]

    $s print "中AB"
    $s scrollUp

    set row [$s scrollbackRow 0]

    set result [list \
        [dict get [lindex $row 0] text] \
        [dict get [lindex $row 0] width] \
        [dict get [lindex $row 1] width]]

    $s destroy
    set result
} -result [list 中 2 0]

test screen-scrollback-007 {clear history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollUp
    $s clearScrollback

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-008 {limit zero disables history} -body {
    set s [::LATerm::Screen new 2 3 0]

    $s print "AAABBB"
    $s scrollUp

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

test screen-scrollback-009 {reducing limit trims oldest rows} -body {
    set s [::LATerm::Screen new 3 3 10]

    $s print "AAABBBCCC"
    $s scrollUp 2
    $s setScrollbackLimit 1

    set result [list \
        [$s scrollbackSize] \
        [$s dumpScrollback]]

    $s destroy
    set result
} -result [list 1 "BBB"]

test screen-scrollback-010 {scroll down does not add history} -body {
    set s [::LATerm::Screen new 2 3 10]

    $s print "AAABBB"
    $s scrollDown

    set result [$s scrollbackSize]

    $s destroy
    set result
} -result 0

::tcltest::cleanupTests

