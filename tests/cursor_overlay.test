
package require Tcl 8.6
package require tcltest 2

namespace import ::tcltest::test

# Skip cleanly when no graphical display is available.
if {[catch {package require Tk} tkError]} {
    puts "Tk unavailable: $tkError"
    ::tcltest::cleanupTests
    return
}

set root [file dirname [file dirname [info script]]]

source [file join $root render/screen.tcl]
source [file join $root parser.tcl]
source [file join $root render/screen_adapter.tcl]
source [file join $root render/tk_renderer.tcl]
source [file join $root cursor_overlay.tcl]

namespace eval ::overlay814 {}

proc ::overlay814::create {} {
    set window .overlay814test

    catch {destroy $window}

    toplevel $window
    wm geometry $window 640x320

    text $window.terminal \
        -font {{DejaVu Sans Mono} 12} \
        -wrap none

    canvas $window.cursor

    pack $window.terminal -fill both -expand 1

    set screen [::LATerm::Screen new 8 20]

    set adapter [::LATerm::ScreenAdapter new $screen]

    set parser [::LATerm::Parser new \
        [list $adapter event]]

    set renderer [::LATerm::TkRenderer new \
        $window.terminal $screen]

    set overlay [::LATerm::CursorOverlay new \
        $window.cursor $window.terminal \
        $renderer $screen]

    $renderer setCursorOverlay $overlay

    update idletasks

    return [list \
        $window $screen $adapter $parser \
        $renderer $overlay]
}

proc ::overlay814::cleanup {objects} {
    lassign $objects window screen adapter parser renderer overlay

    catch {$overlay destroy}
    catch {$renderer destroy}
    catch {$parser destroy}
    catch {$adapter destroy}
    catch {$screen destroy}
    catch {destroy $window}
}

proc ::overlay814::isPlaced {widget} {
    expr {[winfo manager $widget] eq "place"}
}

test cursor-overlay-001 {hidden cursor stays hidden after redraw} -body {
    set objects [::overlay814::create]

    lassign $objects window screen adapter parser renderer overlay

    $overlay refresh
    update idletasks

    set initiallyVisible \
        [::overlay814::isPlaced $window.cursor]

    # Hide the cursor through the real parser.
    $parser feed "\033\[?25l"

    $renderer renderDirty
    update idletasks

    set hidden \
        [::overlay814::isPlaced $window.cursor]

    # Force another full redraw.
    $parser feed "HELLO"
    $renderer render
    update idletasks

    set hiddenAfterRedraw \
        [::overlay814::isPlaced $window.cursor]

    # Restore cursor visibility.
    $parser feed "\033\[?25h"
    $renderer renderDirty
    update idletasks

    set restored \
        [::overlay814::isPlaced $window.cursor]

    set result [list \
        $initiallyVisible \
        $hidden \
        $hiddenAfterRedraw \
        $restored]

    ::overlay814::cleanup $objects

    set result
} -result {1 0 0 1}

test cursor-overlay-002 {hidden cursor remains hidden during blink} -body {
    set objects [::overlay814::create]

    lassign $objects window screen adapter parser renderer overlay

    $parser feed "\033\[?25l"

    $overlay refresh
    $overlay blink

    update idletasks

    set result [::overlay814::isPlaced $window.cursor]

    ::overlay814::cleanup $objects

    set result
} -result 0

::tcltest::cleanupTests
